		lineageTag: 2c2bb7bb-6d3e-4a68-91b9-ca3162b23cb8

	/// M-028
	measure 'Contractor OT Hours' = ```
			CALCULATE ( [Overtime Hours], FACT_LABOUR_COST[employment_type] = "Contractor" )
