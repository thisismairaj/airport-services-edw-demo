	/// before MDM: shows 97 vs 80 golden
	measure 'Source Vendor Ids' = ```
			DISTINCTCOUNT ( FACT_PURCHASE_ORDER[source_vendor_id] )
			```
		formatString: #,0
		displayFolder: Procurement / governance
		lineageTag: 04a159c0-4526-401a-a5a6-b187bb45a5fa

	/// M-032 style control: share of latest-run recon checks with status PASS (INFO excluded)
	measure 'Recon Checks Passed %' = ```
			VAR _run = MAX ( RECON_RESULTS[run_id] )
			RETURN
			    DIVIDE (
			        CALCULATE ( COUNTROWS ( RECON_RESULTS ), RECON_RESULTS[run_id] = _run, RECON_RESULTS[status] = "PASS" ),
			        CALCULATE ( COUNTROWS ( RECON_RESULTS ), RECON_RESULTS[run_id] = _run, RECON_RESULTS[status] <> "INFO" )
			    )
			```
		formatString: 0.0%
		displayFolder: Procurement / governance
		lineageTag: 4f45dd33-2a7d-4dc7-8bf2-bdf22f074657

	measure 'Data Certified As Of' = ```
			MAX ( CERTIFICATION_LOG[certified_at] )
			```
		formatString: dd mmm yyyy hh:nn
		displayFolder: Procurement / governance
		lineageTag: ff87aa79-c6cd-40b3-ae6d-c2f1750cd3c4

	measure 'Last Refresh Label' = ```
			"Certified " & FORMAT ( [Data Certified As Of], "dd MMM yyyy HH:mm" ) & " | Recon " & FORMAT ( [Recon Checks Passed %], "0%" ) & " passed"
			```
		displayFolder: Formatting helpers
		lineageTag: 3f042c4c-7557-4e8c-b68e-5a4351ba18a2

