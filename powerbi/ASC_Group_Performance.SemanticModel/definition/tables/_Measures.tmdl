		formatString: #,0.0
		displayFolder: People
		lineageTag: 44eed917-456c-4be8-8c5d-a6d04b3ad768

	measure 'Contractor OT Hours PM' = ```
			CALCULATE ( [Contractor OT Hours], DATEADD ( DIM_DATE[calendar_date], -1, MONTH ) )
			```
		formatString: #,0.0
		displayFolder: People
		lineageTag: 788eac74-8f02-4e66-b228-f323e6976e1a

	/// Sep-2026 at ASCWF shows +318
	measure 'Contractor OT Δ vs PM (hrs)' = ```
			// blank for the first month, which has no previous month to compare with
			IF ( NOT ISBLANK ( [Contractor OT Hours PM] ), [Contractor OT Hours] - [Contractor OT Hours PM] )
			```
		formatString: +#,0;-#,0;0
		displayFolder: People
		lineageTag: f3cd6e1c-455c-430f-a226-44262daf2a39

	/// M-030
	measure 'Labour Cost' = ```
